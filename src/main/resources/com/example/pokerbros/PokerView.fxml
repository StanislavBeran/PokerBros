<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.Button?>
<AnchorPane prefHeight="740.0" prefWidth="1280.0" style="-fx-background-color: #2b2b2b;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pokerbros.PokerController">
    <children>
        <Button layoutX="20.0" layoutY="20.0" mnemonicParsing="false" onAction="#returnToMenu" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: #c23616; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 10; -fx-cursor: hand;" text="MENU" />


        <ImageView fitHeight="700.0" fitWidth="1100.0" layoutX="90.0" layoutY="20.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@pokertable.png" />
            </image>
        </ImageView>

        <HBox alignment="CENTER" layoutX="320.0" layoutY="310.0" prefHeight="120.0" prefWidth="640.0" spacing="15.0">
            <children>

                <ImageView fx:id="deckImage" fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@pack_of_cards.png" />
                    </image>
                    <HBox.margin>
                        <Insets right="30.0" />
                    </HBox.margin>
                </ImageView>

                <ImageView fx:id="flopCard1" fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                <ImageView fx:id="flopCard2" fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                <ImageView fx:id="flopCard3" fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                <ImageView fx:id="turnCard" fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                <ImageView fx:id="riverCard" fitHeight="120.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
            </children>
        </HBox>

        <!-- HRÁČ 1 -->
        <VBox fx:id="player1Box" alignment="CENTER" layoutX="575.0" layoutY="550.0" prefHeight="130.0" prefWidth="130.0" spacing="5.0" visible="false">
            <children>
                <Label fx:id="player1HandLabel" alignment="CENTER" textFill="#00a8ff" visible="false">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Label fx:id="player1Status" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 5; -fx-padding: 3 8 3 8;" text="Waiting..." textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Pane prefHeight="100.0" prefWidth="130.0">
                    <children>
                        <ImageView fx:id="p1Card1" fitHeight="100.0" fitWidth="70.0" layoutX="15.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true" rotate="-15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                        <ImageView fx:id="p1Card2" fitHeight="100.0" fitWidth="70.0" layoutX="45.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" rotate="15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                    </children>
                </Pane>
            </children>
        </VBox>

        <!-- HRÁČ 2 -->
        <VBox fx:id="player2Box" alignment="CENTER" layoutX="150.0" layoutY="450.0" prefHeight="130.0" prefWidth="130.0" spacing="5.0" visible="false">
