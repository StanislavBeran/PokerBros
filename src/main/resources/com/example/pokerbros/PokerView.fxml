                        <ImageView fx:id="p2Card2" fitHeight="100.0" fitWidth="70.0" layoutX="45.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" rotate="15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                    </children>
                </Pane>
            </children>
        </VBox>

        <!-- HRÁČ 3 -->
        <VBox fx:id="player3Box" alignment="CENTER" layoutX="250.0" layoutY="70.0" prefHeight="130.0" prefWidth="130.0" spacing="5.0" visible="false">
            <children>
                <Label fx:id="player3Status" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 5; -fx-padding: 3 8 3 8;" text="Waiting..." textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
