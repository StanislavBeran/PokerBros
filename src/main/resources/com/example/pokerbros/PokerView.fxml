                <Pane prefHeight="100.0" prefWidth="130.0">
                    <children>
                        <ImageView fx:id="p5Card1" fitHeight="100.0" fitWidth="70.0" layoutX="15.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true" rotate="-15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                        <ImageView fx:id="p5Card2" fitHeight="100.0" fitWidth="70.0" layoutX="45.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" rotate="15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                    </children>
                </Pane>
            </children>
        </VBox>

        <!-- HRÁČ 6 -->
        <VBox fx:id="player6Box" alignment="CENTER" layoutX="1000.0" layoutY="450.0" prefHeight="130.0" prefWidth="130.0" spacing="5.0" visible="false">
            <children>
                <Label fx:id="player6Status" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 5; -fx-padding: 3 8 3 8;" text="Waiting..." textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Pane prefHeight="100.0" prefWidth="130.0">
                    <children>
                        <ImageView fx:id="p6Card1" fitHeight="100.0" fitWidth="70.0" layoutX="15.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true" rotate="-15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                        <ImageView fx:id="p6Card2" fitHeight="100.0" fitWidth="70.0" layoutX="45.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" rotate="15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                    </children>
                </Pane>
            </children>
        </VBox>
        <Label fx:id="turnLabel" alignment="CENTER" layoutX="440.0" layoutY="30.0" prefWidth="500.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-background-radius: 10; -fx-padding: 10;" text="Na řadě je: Hráč 1" textFill="#e1b12c">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <HBox fx:id="actionPanel" alignment="CENTER" layoutX="490.0" layoutY="480.0" prefHeight="50.0" prefWidth="300.0" spacing="15.0" visible="false">
            <children>
                <Button mnemonicParsing="false" onAction="#handleFold" prefWidth="90.0" style="-fx-background-color: #c23616; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="FOLD" />
                <Button mnemonicParsing="false" onAction="#handleCheck" prefWidth="90.0" style="-fx-background-color: #fbc531; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;" text="CHECK/CALL" />
                <Button mnemonicParsing="false" onAction="#handleRaise" prefWidth="90.0" style="-fx-background-color: #44bd32; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="RAISE" />
            </children>
        </HBox>
        <Button layoutX="20.0" layoutY="70.0" mnemonicParsing="false" onAction="#showCombinations" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-background-radius: 10; -fx-cursor: hand;" text="COMBINATIONS" />
        <javafx.scene.layout.StackPane fx:id="combinationsOverlay" onMouseClicked="#hideCombinations" prefHeight="740.0" prefWidth="1280.0" style="-fx-background-color: rgba(0,0,0,0.8);" visible="false">
            <children>
                <ImageView fitHeight="700.0" fitWidth="500.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@combinations.png" />
                    </image>
                </ImageView>
