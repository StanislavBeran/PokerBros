                    </children>
                </Pane>
            </children>
        </VBox>

        <!-- HRÁČ 4 -->
        <VBox fx:id="player4Box" alignment="CENTER" layoutX="575.0" layoutY="20.0" prefHeight="130.0" prefWidth="130.0" spacing="5.0" visible="false">
            <children>
                <Label fx:id="player4Status" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 5; -fx-padding: 3 8 3 8;" text="Waiting..." textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Pane prefHeight="100.0" prefWidth="130.0">
                    <children>
                        <ImageView fx:id="p4Card1" fitHeight="100.0" fitWidth="70.0" layoutX="15.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true" rotate="-15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                        <ImageView fx:id="p4Card2" fitHeight="100.0" fitWidth="70.0" layoutX="45.0" layoutY="10.0" pickOnBounds="true" preserveRatio="true" rotate="15.0"><image><Image url="@pack_of_cards.png" /></image></ImageView>
                    </children>
                </Pane>
            </children>
        </VBox>

        <!-- HRÁČ 5 -->
        <VBox fx:id="player5Box" alignment="CENTER" layoutX="900.0" layoutY="70.0" prefHeight="130.0" prefWidth="130.0" spacing="5.0" visible="false">
            <children>
                <Label fx:id="player5Status" alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.6); -fx-background-radius: 5; -fx-padding: 3 8 3 8;" text="Waiting..." textFill="WHITE">
                    <font><Font name="System Bold" size="14.0" /></font>
